// © ChiamakaS
//@version=6
indicator("Sniper Alert Wrapper", overlay=false)

// ==========================================
// 0. CONSTANTS & DEFINITIONS
// ==========================================
// 'color.gold' is not built-in, so we define it manually:
colGold = #FFD700 

// ==========================================
// 1. INPUTS
// ==========================================

// --- RSI Settings ---
grp_rsi = "RSI Settings"
lenRsi  = input.int(14, "RSI Length", group=grp_rsi)

// --- WaveTrend Settings ---
grp_wt  = "WaveTrend Settings"
lenWt   = input.int(10, "WT Channel Len", group=grp_wt)
lenAvg  = input.int(21, "WT Average Len", group=grp_wt)

// --- Trend Filter Settings ---
grp_trend = "Trend Regime Filter"
useTrend  = input.bool(true, "Filter Counter-Trend Signals?", group=grp_trend)
tfTrend   = input.timeframe("5", "Trend Timeframe", group=grp_trend)
lenTrend  = input.int(50, "Trend EMA Length", group=grp_trend)

// --- Volume Settings ---
grp_vol = "Volume Settings"
lenVol     = input.int(20, "Vol MA Len", group=grp_vol)
rvolThresh = input.float(1.25, "RVOL Threshold", group=grp_vol)

// --- Conviction / Bayesian Weights ---
grp_bayes = "Conviction Logic"
wtWeight  = input.float(40.0, "WT Weight (0-50)", minval=0, maxval=50, group=grp_bayes)
rsiWeight = input.float(30.0, "RSI Weight (0-50)", minval=0, maxval=50, group=grp_bayes)
volWeight = input.float(30.0, "Vol Weight (0-50)", minval=0, maxval=50, group=grp_bayes)

// ==========================================
// 2. CALCULATIONS
// ==========================================

// --- RSI ---
rsiVal = ta.rsi(close, lenRsi)

// --- WaveTrend (Normalized) ---
// 1. Calculate Standard WaveTrend
ap      = hlc3
esa     = ta.ema(ap, lenWt)
d       = ta.ema(math.abs(ap - esa), lenWt)
ci      = (ap - esa) / (0.015 * d)
wtRaw   = ta.ema(ci, lenAvg)

// 2. Normalize to fit RSI Scale (0-100)
wt1     = (wtRaw * 0.25) + 50   // Fast Line (Green)
wt2     = ta.sma(wt1, 4)        // Slow Line (Red)

// --- Trend Regime (EMA Slope) ---
// Get EMA from higher timeframe (non-repainting)
trendEma = request.security(syminfo.tickerid, tfTrend, ta.ema(close, lenTrend), lookahead=barmerge.lookahead_off)
// Calculate Slope (Current - Previous)
trendSlope = trendEma - trendEma[1]
isBullish  = trendSlope > 0
isBearish  = trendSlope < 0

// --- Session Logic (Time-Weighted Volume) ---
// Get UTC Hour
hourUTC = hour(time, "UTC")

// Define Sessions
isAsia    = hourUTC >= 23 or hourUTC < 7
isEurope  = hourUTC >= 7 and hourUTC < 13
isAmerica = hourUTC >= 13 and hourUTC < 21
isAfter   = hourUTC >= 21 and hourUTC < 23

// Define Weekend (Saturday=7, Sunday=1 in Pine)
dayOfWeek = dayofweek(time, "UTC")
isWeekend = dayOfWeek == dayofweek.saturday or dayOfWeek == dayofweek.sunday

// Determine Vol Multiplier & Session Name
float volMult = 1.0
string sessName = "N/A"

if isWeekend
    volMult  := 0.35
    sessName := "WEEKEND"
else if isAsia
    volMult  := 0.70
    sessName := "ASIA"
else if isEurope
    volMult  := 1.20
    sessName := "EUROPE"
else if isAmerica
    volMult  := 1.40
    sessName := "AMERICA"
else 
    // After Hours
    volMult  := 0.50
    sessName := "POST-MKT"

// --- Volume (RVOL) ---
volMa   = ta.sma(volume, lenVol)
rvol    = volMa > 0 ? volume / volMa : 0.0
//Check if volume has been high for at least 2 of the last 3 bars (Anti-Drift)
isSustainedVol = math.sum(rvol > rvolThresh ? 1 : 0, 3) >= 2 
volOk    = isSustainedVol // Replaces rvol > rvolThresh

// ==========================================
// 3. WAGER CONTEXT (15m Window & Strike)
// ==========================================

// A. Detect New Window (00, 15, 30, 45)
isNewWindow = ta.change(time("15")) != 0

// B. Capture Strike Price
var float wagerOpen = na
if isNewWindow
    wagerOpen := open

// C. Time Decay Calculation
// Calculate how many minutes have passed in the current 15m window
msInWindow  = time % (15 * 60 * 1000)
minsElapsed = msInWindow / 60000.0

// Decay Factor: Sigmoid Cliff Logic
// Min 0-9:   1.0 -> 0.8 (Safe Zone)
// Min 10-11: 0.8 -> 0.6 (Caution Zone)
// Min 12-13: 0.6 -> 0.25 (The Cliff)
// Min 14+:   0.1 (Floor)

float timeDecay = 0.1
if minsElapsed < 10
    // 0 to 9.99 mins: Map 0-10 range to 1.0-0.8
    timeDecay := 1.0 - (minsElapsed / 10.0) * 0.2
else if minsElapsed < 12
    // 10 to 11.99 mins: Map 10-12 range to 0.8-0.6
    timeDecay := 0.8 - ((minsElapsed - 10.0) / 2.0) * 0.2
else if minsElapsed < 14
    // 12 to 13.99 mins: Map 12-14 range to 0.6-0.25
    timeDecay := 0.6 - ((minsElapsed - 12.0) / 2.0) * 0.35
else
    // 14+ mins
    timeDecay := 0.1 

// D. Calculate Real-time Gap X
float gapX = na
if not na(wagerOpen)
    gapX := close - wagerOpen

// ==========================================
// 4. CONVICTION SCORE (The Bayesian Update)
// ==========================================

// A. RSI Evidence (0.0 to 1.0)
float rsiScore = 0.0
if rsiVal < 35
    rsiScore := (35 - rsiVal) / 15.0 
else if rsiVal > 65
    rsiScore := (rsiVal - 65) / 15.0 
rsiScore := math.min(rsiScore, 1.0)

// B. WaveTrend Evidence (0.0 to 1.0)
wtGap    = math.abs(wt1 - wt2)
wtScore  = math.min(wtGap / 5.0, 1.0) 

// C. Volume Evidence (0.0 to 1.0) WITH SESSION WEIGHT
// Base Score
baseVolScore = math.min(rvol / (rvolThresh * 2), 1.0)
// Apply Session Multiplier
volScore = math.min(baseVolScore * volMult, 1.0) 

// D. Trend Validation (VETO POWER)
// If Trend Filter is ON:
// - Bullish Regime (Slope > 0) -> Block SELLs (allow only dip buys)
// - Bearish Regime (Slope < 0) -> Block BUYs (allow only rally sells)
// We check the POTENTIAL signal direction against the regime.
// Instead of modifying the inputs, we nullify the score if it defies the regime.

bool trendVeto = false
if useTrend
    // If calculating score for a BUY scenario (Low RSI), we need Bullish trend
    if rsiVal < 50 and isBearish
        trendVeto := true
    // If calculating score for a SELL scenario (High RSI), we need Bearish trend
    if rsiVal > 50 and isBullish
        trendVeto := true

// E. Total Weighted Score
rawScore = (wtScore * wtWeight) + (rsiScore * rsiWeight) + (volScore * volWeight)

// Apply Veto (Force to 0 if fighting the trend)
if trendVeto
    rawScore := 0.0

// F. Apply Time Decay
finalConviction = rawScore * timeDecay

// --- Cross Logic (Moved down to use final Check) ---
wtCrossUp = ta.crossover(wt1, wt2)
wtCrossDn = ta.crossunder(wt1, wt2)

// ==========================================
// 5. TRIGGERS
// ==========================================

// Trend Ok?
// Buy: Need Bullish Slope or Filter OFF
// Sell: Need Bearish Slope or Filter OFF
trendBuyOk  = not useTrend or isBullish
trendSellOk = not useTrend or isBearish

buySignal  = rsiVal < 35 and wtCrossUp and volOk and trendBuyOk
sellSignal = rsiVal > 65 and wtCrossDn and volOk and trendSellOk

// ==========================================
// 6. VISUALS
// ==========================================

// --- Main Chart Strike Line ---

// If it's the live bar: Green if Price > Strike, Red if Price <= Strike.
// If it's a closed bar: Yellow (History).
strikeColor = barstate.islast ? (close > wagerOpen ? color.green : color.red) : color.yellow

// force_overlay=true puts this line on the Main Chart (Price), not the Indicator pane
plot(wagerOpen, "Wager Strike", strikeColor, linewidth=2, style=plot.style_stepline, force_overlay=true)

// --- Indicator Pane ---

// 1. Conviction Line
plot(finalConviction, "Conviction Score", color.new(colGold, 20), linewidth=3, style=plot.style_area)

// 2. Reference Lines
hTop = hline(65, "Upper", color.red)
hBot = hline(35, "Lower", color.green)
fill(hTop, hBot, color.new(color.blue, 90))

// 3. Main Indicators
plot(rsiVal, "RSI", color.blue, linewidth=2)
plot(wt1, "WT Fast", color.new(color.green, 30))
plot(wt2, "WT Slow", color.new(color.red, 30))

// 4. Signal Markers
plotshape(buySignal, "Sniper YES", shape.labelup, location.bottom, color.green, 0, "YES", color.white, size=size.tiny)
plotshape(sellSignal, "Sniper NO", shape.labeldown, location.top, color.red, 0, "NO", color.white, size=size.tiny)

// ==========================================
// 7. HUD DASHBOARD (Table)
// ==========================================

var table hud = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 50), border_width=1)

if barstate.islast
    // Row 1: Time Left
    minsLeft = 14 - math.floor(minsElapsed)
    secLeft  = 60 - math.floor((msInWindow % 60000) / 1000)
    timeLeftStr = str.tostring(minsLeft) + "m " + str.tostring(secLeft) + "s"
    
    // Row 2: Conviction
    convColor = finalConviction > 50 ? color.green : finalConviction > 25 ? color.yellow : color.gray
    
    // Row 3: Gap X
    gapColor = gapX > 0 ? color.green : color.red
    gapStr   = str.tostring(math.abs(gapX), "#.##")
    
    // Row 4: Regime
    regimeStr = isBullish ? "BULLISH" : "BEARISH"
    regimeCol = isBullish ? color.green : color.red
    
    // Row 5: Session
    sessColor = isAmerica or isEurope ? color.green : color.orange

    // Row 6: Wager Status
    wagerStatus = close > wagerOpen ? "WINNING" : "LOSING"
    statusColor = close > wagerOpen ? color.green : color.red

    // Fill Table
    table.cell(hud, 0, 0, "Time Left:", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0, timeLeftStr, text_color=color.white, text_size=size.small, bgcolor=minsLeft < 3 ? color.new(color.red, 60) : na)
    
    table.cell(hud, 0, 1, "Conviction:", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 1, str.tostring(math.round(finalConviction, 0)) + "%", text_color=convColor, text_size=size.small)
    
    table.cell(hud, 0, 2, "Gap X:", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 2, gapStr, text_color=gapColor, text_size=size.small)
    
    table.cell(hud, 0, 3, "Regime:", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 3, regimeStr, text_color=regimeCol, text_size=size.small)

    table.cell(hud, 0, 4, "Session:", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 4, sessName, text_color=sessColor, text_size=size.small)

    table.cell(hud, 0, 5, "Wager:", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 5, wagerStatus, text_color=statusColor, text_size=size.small)

// ==========================================
// 8. ALERTS
// ==========================================
alertcondition(buySignal, "SNIPER YES", "YES Setup | Score: {{plot('Conviction Score')}} | Price {{close}}")
alertcondition(sellSignal, "SNIPER NO", "NO Setup | Score: {{plot('Conviction Score')}} | Price {{close}}")